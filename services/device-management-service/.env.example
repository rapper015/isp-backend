# Device Management Service environment (Milestone 7)
SERVICE_NAME=device-management-service
DATABASE_URL=postgresql://device_management:device_management@localhost:5432/device_management
REDIS_URL=redis://localhost:6379/0

# Security
DEVICE_MANAGEMENT_JWT_SECRET=replace-with-a-secret-at-least-32-chars
DEVICE_MANAGEMENT_INTERNAL_API_KEY=replace-me
DEVICE_MANAGEMENT_ENCRYPTION_KEY=replace-with-a-32-byte-kms-derived-secret
DEVICE_MANAGEMENT_RATE_LIMIT=120

# GenieACS integration (provider: fake | genieacs)
ACS_PROVIDER=fake
GENIEACS_BASE_URL=http://genieacs:7557
GENIEACS_VERIFY_TLS=true
GENIEACS_TIMEOUT_SECONDS=10
GENIEACS_MAX_RETRIES=3

# Cross-service gateway base URLs (thin HTTP adapters; unset = dependency unavailable)
DEVICE_CRM_BASE_URL=
DEVICE_OSS_BASE_URL=
DEVICE_INVENTORY_BASE_URL=
DEVICE_WORKFORCE_BASE_URL=
DEVICE_SUPPORT_BASE_URL=
DEVICE_NMS_BASE_URL=
CRM_INTERNAL_API_KEY=
OSS_INTERNAL_API_KEY=
INVENTORY_INTERNAL_API_KEY=
WORKFORCE_INTERNAL_API_KEY=
SUPPORT_INTERNAL_API_KEY=
NMS_INTERNAL_API_KEY=

# Firmware storage
DEVICE_FIRMWARE_DIR=./firmware
DEVICE_FIRMWARE_MAX_BYTES=104857600

# Telemetry
DEVICE_MGMT_TELEMETRY_RETENTION_DAYS=90

# Worker
DEVICE_MGMT_WORKER_INTERVAL=10
DEVICE_MGMT_JOB_TIMEOUT_MINUTES=30

# RabbitMQ (worker)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Dev/test
DEVICE_MGMT_AUTO_CREATE_SCHEMA=true
