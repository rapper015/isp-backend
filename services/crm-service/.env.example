# Set all values in the deployment secret manager; placeholders are not valid secrets.
DATABASE_URL=postgresql://crm_user:replace-me@postgres:5432/crm
RABBITMQ_URL=amqp://crm_user:replace-me@rabbitmq:5672/
VALKEY_URL=redis://valkey:6379/0

# Use either one key or a comma-separated rotation set. Never commit real values.
CRM_INTERNAL_API_KEY=replace-with-a-strong-random-value
CRM_INTERNAL_API_KEYS=
CRM_ENCRYPTION_KEY=replace-with-a-fernet-key
CRM_TRUSTED_SOURCES=

# Shared with the platform admin-token issuer.
CRM_JWT_SECRET=replace-with-the-platform-admin-jwt-secret

CRM_INTERNAL_RATE_LIMIT=300
CRM_MANAGEMENT_RATE_LIMIT=120
CRM_REQUEST_MAX_BYTES=65536

# Keep false in deployed environments; apply Alembic migrations before startup.
CRM_AUTO_CREATE_SCHEMA=false

# Follow-up scheduling / notification worker interval (seconds).
CRM_FOLLOWUP_WORKER_INTERVAL_SECONDS=60
LOG_LEVEL=INFO

# Comma-separated browser origins allowed to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
