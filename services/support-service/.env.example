# Support Service environment (Milestone 5)
SERVICE_NAME=support-service
DATABASE_URL=postgresql://support:support@localhost:5432/support_db
REDIS_URL=redis://localhost:6379/0

# Security
SUPPORT_JWT_SECRET=replace-with-a-secret-at-least-32-chars
SUPPORT_CUSTOMER_JWT_SECRET=replace-with-another-secret-at-least-32-chars
SUPPORT_INTERNAL_API_KEY=replace-me
SUPPORT_MANAGEMENT_RATE_LIMIT=120
SUPPORT_PORTAL_RATE_LIMIT=60

# Cross-service gateway base URLs (thin HTTP adapters; unset = dependency unavailable)
SUPPORT_CRM_BASE_URL=
SUPPORT_BSS_BASE_URL=
SUPPORT_OSS_BASE_URL=
SUPPORT_AAA_BASE_URL=
SUPPORT_NETWORK_BASE_URL=
SUPPORT_NMS_BASE_URL=
SUPPORT_IPAM_BASE_URL=
SUPPORT_WORKFORCE_BASE_URL=
SUPPORT_NOTIFICATIONS_BASE_URL=
CRM_INTERNAL_API_KEY=
BSS_INTERNAL_API_KEY=
OSS_INTERNAL_API_KEY=
AAA_INTERNAL_API_KEY=
NMS_INTERNAL_API_KEY=
IPAM_INTERNAL_API_KEY=
WORKFORCE_INTERNAL_API_KEY=
NOTIFICATIONS_INTERNAL_API_KEY=

# Attachments
SUPPORT_ATTACHMENT_DIR=./attachments
SUPPORT_ATTACHMENT_RETENTION_DAYS=365

# RabbitMQ (worker)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Worker
SUPPORT_WORKER_INTERVAL=10

# Dev/test
SUPPORT_AUTO_CREATE_SCHEMA=true
