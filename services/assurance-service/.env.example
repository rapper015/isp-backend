# Assurance Service (Milestone 9 — Observability & Service Assurance)
# The Python service is the assurance/governance layer only. Raw metrics, logs
# and traces live in Prometheus / Loki / Tempo via the OpenTelemetry Collector.

DATABASE_URL=postgresql://assurance:assurance@postgres:5432/assurance

ASSURANCE_JWT_SECRET=change-me-to-a-random-string-of-32-or-more-chars
ASSURANCE_INTERNAL_API_KEY=change-me-internal-service-key

# Structured JSON logging (shared/isp_shared/telemetry.py)
LOG_LEVEL=INFO
LOG_JSON=true
SERVICE_NAME=assurance-service
ENVIRONMENT=development

# Redis (rate limiting / cache)
REDIS_URL=redis://redis:6379/0
ASSURANCE_RATE_LIMIT=120

# RabbitMQ (event bus; outbox/inbox)
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
ASSURANCE_EXCHANGE=assurance.events.v1
