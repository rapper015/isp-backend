# OSS Service environment (Milestone 2)
SERVICE_NAME=oss-service
DATABASE_URL=postgresql://oss:oss@localhost:5432/oss_db
REDIS_URL=redis://localhost:6379/0

# Security
OSS_JWT_SECRET=replace-with-a-secret-at-least-32-chars
OSS_ENCRYPTION_KEY=generate-with-fernet-generate-key
OSS_INTERNAL_API_KEY=replace-me
OSS_INTERNAL_API_KEYS=replace-me
OSS_MANAGEMENT_RATE_LIMIT=120

# RabbitMQ (worker)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Worker
OSS_WORKER_INTERVAL=10

# Dev/test
OSS_AUTO_CREATE_SCHEMA=true
