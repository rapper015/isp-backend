# Intelligence Service (Milestone 10 — AI & Intelligence Layer)
# Governed intelligence layer. The AI never mutates domain state directly;
# operational changes flow through remediation intents to authoritative services.

DATABASE_URL=postgresql://intelligence:intelligence@postgres:5432/intelligence

INTELLIGENCE_JWT_SECRET=change-me-to-a-random-string-of-32-or-more-chars
INTELLIGENCE_INTERNAL_API_KEY=change-me-internal-service-key

# Structured JSON logging (shared/isp_shared/telemetry.py)
LOG_LEVEL=INFO
LOG_JSON=true
SERVICE_NAME=intelligence-service
ENVIRONMENT=development

# Redis (online feature cache / rate limiting)
REDIS_URL=redis://valkey:6379/0
INTELLIGENCE_RATE_LIMIT=120

# RabbitMQ (event bus; outbox/inbox)
RABBITMQ_URL=amqp://isp:isp@rabbitmq:5672/
INTELLIGENCE_EXCHANGE=intelligence.events.v1

# Optional analytical warehouse abstraction (future S3+Parquet / ClickHouse).
# The intelligence DB (Postgres) is the default store; Redis is only an online
# feature cache and never historical truth.
WAREHOUSE_ENGINE=postgres
