# BSS Service — Milestone 4 (Payments & Revenue Automation)
DATABASE_URL=postgresql://bss:replace-me@postgres:5432/bss
RABBITMQ_URL=amqp://bss:replace-me@rabbitmq:5672/
VALKEY_URL=redis://valkey:6379/0

# Security
BSS_JWT_SECRET=replace-with-the-platform-admin-jwt-secret-at-least-32-chars
BSS_INTERNAL_API_KEY=replace-with-a-strong-random-value
BSS_INTERNAL_API_KEYS=
BSS_ENCRYPTION_KEY=replace-with-a-fernet-key   # encrypts gateway credentials/webhook secrets
BSS_WEBHOOK_RATE_LIMIT=300
BSS_AUTO_CREATE_SCHEMA=false

# Gateway (Razorpay production adapter). Live HTTP calls are only performed when
# BSS_GATEWAY_LIVE=true (sandbox/integration mode). Webhooks are always verified
# with the per-account webhook secret.
BSS_GATEWAY_LIVE=false
RAZORPAY_API_BASE=https://api.razorpay.com

# Manual payments
BSS_MANUAL_PAYMENT_APPROVAL_THRESHOLD=5000.00

# Worker
BSS_WORKER_INTERVAL_SECONDS=5
BSS_OUTBOX_BATCH_SIZE=100
