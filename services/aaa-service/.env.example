# Set all values in the deployment secret manager; placeholders are not valid secrets.
DATABASE_URL=postgresql://aaa_user:replace-me@postgres:5432/aaa
RABBITMQ_URL=amqp://aaa_user:replace-me@rabbitmq:5672/
VALKEY_URL=redis://valkey:6379/0

# Use either one key or a comma-separated rotation set. Never commit real values.
AAA_INTERNAL_API_KEY=replace-with-a-strong-random-value
AAA_INTERNAL_API_KEYS=
AAA_ENCRYPTION_KEY=replace-with-a-fernet-key
AAA_TRUSTED_SOURCES=
AAA_MTLS_IDENTITIES=

AAA_INTERNAL_RATE_LIMIT=300
AAA_SESSION_STALE_SECONDS=900
AAA_RADIUS_HEARTBEAT_SECONDS=120
AAA_OUTBOX_BATCH_SIZE=100
LOG_LEVEL=INFO
