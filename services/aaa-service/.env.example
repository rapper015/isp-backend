# Set all values in the deployment secret manager; placeholders are not valid secrets.
DATABASE_URL=postgresql://aaa_user:replace-me@postgres:5432/aaa
RABBITMQ_URL=amqp://aaa_user:replace-me@rabbitmq:5672/
VALKEY_URL=redis://valkey:6379/0

# Use either one key or a comma-separated rotation set. Never commit real values.
AAA_INTERNAL_API_KEY=replace-with-a-strong-random-value
AAA_INTERNAL_API_KEYS=
AAA_ENCRYPTION_KEY=replace-with-a-fernet-key
AAA_TRUSTED_SOURCES=
AAA_MTLS_IDENTITIES=

AAA_INTERNAL_RATE_LIMIT=300
AAA_REQUEST_MAX_BYTES=65536
NAS_APPROVED_NETWORKS=10.0.0.0/8,192.168.0.0/16
# Allow hostname (not just IP) management endpoints. Keep false in production.
NAS_ALLOW_HOSTNAMES=false
# Keep false in production; permits TLS verification to be disabled per NAS.
AAA_ALLOW_INSECURE_TLS=false
AAA_MANAGEMENT_RATE_LIMIT=120
# Shared with the platform admin-token issuer; do not use a development value in production.
AAA_JWT_SECRET=replace-with-the-platform-admin-jwt-secret
# Keep false in deployed environments; apply Alembic migrations before startup.
AAA_AUTO_CREATE_SCHEMA=false
AAA_SESSION_STALE_SECONDS=900
AAA_RADIUS_HEARTBEAT_SECONDS=120
AAA_OUTBOX_BATCH_SIZE=100
AAA_COMMAND_MAX_ATTEMPTS=3
AAA_WORKER_INTERVAL_SECONDS=5
# Leave false until NAS command delivery has been explicitly approved and configured.
AAA_ENABLE_RADIUS_COMMANDS=false
AAA_RADIUS_COMMAND_TIMEOUT=2
AAA_RADIUS_COMMAND_RETRIES=2
# NAS / RouterOS orchestration
AAA_ROUTEROS_ADAPTER=real                 # real | fake (fake is for tests/simulations only)
AAA_ROUTEROS_CONNECT_TIMEOUT=5
AAA_ROUTEROS_COMMAND_TIMEOUT=10
AAA_NAS_LOCK_TTL_SECONDS=90
AAA_NAS_HEALTH_INTERVAL_SECONDS=300
AAA_NAS_HEALTH_BATCH=10
LOG_LEVEL=INFO
