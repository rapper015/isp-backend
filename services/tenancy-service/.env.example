# Tenancy Service (Milestone 8) environment template.
# Copy to .env and fill in production values. Secrets must be >= 32 chars.

# Management JWT (RBAC for /api/tenancy/*). Must be >= 32 chars.
TENANCY_JWT_SECRET=change-me-32-char-minimum-jwt-secret
# Internal service key (inbound event ingestion).
TENANCY_INTERNAL_API_KEY=change-me-internal-key
# Encryption key material for encrypted secret references (partner/tenant secrets).
TENANCY_ENCRYPTION_KEY=change-me-32-char-minimum-encryption-key

# Database (control plane). Defaults to SQLite for hermetic tests.
DATABASE_URL=postgresql://isp:isp@postgres:5432/tenancy

# Messaging / cache.
RABBITMQ_URL=amqp://isp:isp@rabbitmq:5672/
REDIS_URL=redis://valkey:6379/0

# Worker.
TENANCY_WORKER_INTERVAL=30

# Rate limiting.
TENANCY_RATE_LIMIT=120
