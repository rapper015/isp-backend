# Identity service (application users + login). Separate from AAA/FreeRADIUS.

DATABASE_URL=sqlite:///./identity.db
# DATABASE_URL=postgresql://identity_user:replace-me@postgres:5432/identity

# Login signs with PLATFORM_JWT_SECRET if set, else IDENTITY_JWT_SECRET (>= 32 chars).
# Set the same value on every service's <SVC>_JWT_SECRET so one token works platform-wide.
PLATFORM_JWT_SECRET=
IDENTITY_JWT_SECRET=change-me-identity-jwt-secret-0123456789abcdef
IDENTITY_TOKEN_TTL_SECONDS=43200

# Internal service key for user-management endpoints (create/list users).
IDENTITY_INTERNAL_API_KEY=change-me-identity-internal-key
IDENTITY_INTERNAL_API_KEYS=

# Bootstrap the first platform admin at startup if no users exist.
IDENTITY_BOOTSTRAP_ADMIN_USERNAME=
IDENTITY_BOOTSTRAP_ADMIN_PASSWORD=

# Self-service registration for frontend developers (POST /api/auth/register).
IDENTITY_ALLOW_REGISTRATION=true
# Role assigned to self-registered users (never settable by the caller).
IDENTITY_REGISTRATION_ROLE=READ_ONLY

LOG_LEVEL=INFO
