# Workforce Service environment (Milestone 6)
SERVICE_NAME=workforce-service
DATABASE_URL=postgresql://workforce:workforce@localhost:5432/workforce_db
REDIS_URL=redis://localhost:6379/0

# Security
WORKFORCE_JWT_SECRET=replace-with-a-secret-at-least-32-chars
WORKFORCE_TECHNICIAN_JWT_SECRET=replace-with-a-secret-at-least-32-chars
WORKFORCE_CUSTOMER_JWT_SECRET=replace-with-a-secret-at-least-32-chars
WORKFORCE_INTERNAL_API_KEY=replace-me
WORKFORCE_MANAGEMENT_RATE_LIMIT=120
WORKFORCE_TECHNICIAN_RATE_LIMIT=180
WORKFORCE_CUSTOMER_RATE_LIMIT=60

# Cross-service gateway base URLs (thin HTTP adapters; unset = dependency unavailable)
WORKFORCE_CRM_BASE_URL=
WORKFORCE_SUPPORT_BASE_URL=
WORKFORCE_OSS_BASE_URL=
WORKFORCE_AAA_BASE_URL=
WORKFORCE_NETWORK_BASE_URL=
WORKFORCE_NMS_BASE_URL=
WORKFORCE_IPAM_BASE_URL=
WORKFORCE_INVENTORY_BASE_URL=
WORKFORCE_BILLING_BASE_URL=
WORKFORCE_NOTIFICATIONS_BASE_URL=
CRM_INTERNAL_API_KEY=
SUPPORT_INTERNAL_API_KEY=
OSS_INTERNAL_API_KEY=
AAA_INTERNAL_API_KEY=
NMS_INTERNAL_API_KEY=
IPAM_INTERNAL_API_KEY=
INVENTORY_INTERNAL_API_KEY=
BILLING_INTERNAL_API_KEY=
NOTIFICATIONS_INTERNAL_API_KEY=

# Maps provider: "fake" (default, used in tests), "google", "alternative"
MAPS_PROVIDER=fake
GOOGLE_MAPS_API_KEY=

# Proof of work / attachments
WORKFORCE_ATTACHMENT_DIR=./attachments
WORKFORCE_ATTACHMENT_MAX_BYTES=52428800
WORKFORCE_ATTACHMENT_RETENTION_DAYS=365

# GPS enforcement
WORKFORCE_GEOFENCE_RADIUS_M=500

# RabbitMQ (worker)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Worker
WORKFORCE_WORKER_INTERVAL=10

# Dev/test
WORKFORCE_AUTO_CREATE_SCHEMA=true
