# Workforce service environment (Master Spec Batch 2)

# Database (Postgres in compose, SQLite locally)
DATABASE_URL=sqlite:///./workforce.db
# DATABASE_URL=postgresql://workforce_user:replace-me@postgres:5432/workforce

RABBITMQ_URL=amqp://isp:isp@rabbitmq:5672/
VALKEY_URL=redis://valkey:6379/0

# --- Security secrets (REPLACE before going live) ---
# WORKFORCE_JWT_SECRET MUST be at least 32 characters.
WORKFORCE_JWT_SECRET=change-me-workforce-jwt-secret-0123456789abcdef
WORKFORCE_INTERNAL_API_KEY=change-me-workforce-internal-key

# Worker poll interval (seconds)
WORKFORCE_WORKER_INTERVAL=30

LOG_LEVEL=INFO
