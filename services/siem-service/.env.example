# SIEM service environment (Master Spec Batch 1)

# Database (Postgres in compose, SQLite locally)
DATABASE_URL=sqlite:///./siem.db
# DATABASE_URL=postgresql://siem_user:replace-me@postgres:5432/siem

# Message broker + cache (used by the worker/outbox)
RABBITMQ_URL=amqp://isp:isp@rabbitmq:5672/
VALKEY_URL=redis://valkey:6379/0

# --- Security secrets (REPLACE before going live) ---
# SIEM_JWT_SECRET MUST be at least 32 characters; the API returns 503 otherwise.
SIEM_JWT_SECRET=change-me-siem-jwt-secret-0123456789abcdef
# Internal API key for the high-volume ingest endpoint.
SIEM_INTERNAL_API_KEY=change-me-siem-internal-key
# Used to encrypt sensitive event fields at rest (>= 32 characters).
SIEM_ENCRYPTION_KEY=change-me-siem-encryption-key-0123456789abcdef

# Worker poll interval (seconds)
SIEM_WORKER_INTERVAL=30

LOG_LEVEL=INFO
