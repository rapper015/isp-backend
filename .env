# NOT currently read by config/settings.py (ALLOWED_HOSTS is hardcoded to ["*"]
# there right now) - kept here only so the value is ready to use if that gets
# switched back to reading the env var.
ALLOWED_HOSTS=localhost,127.0.0.1

# Left unset on purpose: no local Postgres is running on this machine, so
# settings.py falls back to sqlite (db.sqlite3) when DATABASE_URL is absent.
# Uncomment and point at a real Postgres instance if you set one up locally.
# DATABASE_URL=postgres://isp_user:isp_password@localhost:5432/isp_platform

INTERNAL_API_KEY=gAXJvaE8M3unomiwtuY2xyRvCT5zRrUurJF8OnHDH14

# NOT read by this Django app at all (manage.py runserver takes its port as a
# CLI arg, not an env var) - kept only for parity with the Node service's
# .env.example, which this file was originally modeled on. Together with
# APP_HOST below, this is what FreeRADIUS's connect_uri targets to reach
# this app - see docs/freeradius/isp-platform-rest.conf.
PORT=8000

# Where FreeRADIUS should reach this Django app (its rlm_rest connect_uri).
# 127.0.0.1 only works if FreeRADIUS runs on this same host/network
# namespace. If FreeRADIUS is on a genuinely different server, this must be
# this server's real reachable address (public IP, or private/VPN IP if
# they share a private network) - and see docs/freeradius/isp-platform-rest.conf
# for why FreeRADIUS then needs its OWN local env file rather than this one.
APP_HOST=127.0.0.1

