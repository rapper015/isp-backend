# =============================================================================
# ISP Platform — Docker Compose environment
#
# Copy this file to `.env` (already gitignored) and fill in REAL secrets:
#   cp .env.example .env
#
# docker compose automatically loads `.env` from the project root and
# substitutes ${VAR} references in docker-compose.yml.
#
# Generate secrets:  openssl rand -hex 32   (macOS/Linux/WSL/Git Bash)
#                or  [System.Security.Cryptography.RandomNumberGenerator]::GetHexString(32)  (PowerShell)
# =============================================================================

# ---- Gateway / exposed ports -----------------------------------------------
# The edge gateway is published on GATEWAY_PORT; all platform APIs go through it.
GATEWAY_PORT=4000
# Grafana (observability profile only) is published on GRAFANA_PORT.
GRAFANA_PORT=3000

# ---- Shared infrastructure (must match docker-compose services) -------------
POSTGRES_USER=isp
POSTGRES_PASSWORD=isp
RABBITMQ_DEFAULT_USER=isp
RABBITMQ_DEFAULT_PASS=isp

# ---- Intelligence service (Milestone 10) ------------------------------------
# INTELLIGENCE_JWT_SECRET MUST be at least 32 characters, otherwise the
# management API returns HTTP 503. Change BOTH of these before going live.
INTELLIGENCE_JWT_SECRET=change-me-intelligence-jwt-secret-0123456789abcdef
INTELLIGENCE_INTERNAL_API_KEY=change-me-intelligence-internal-key
# Rate limit for management endpoints (requests / minute / client IP).
INTELLIGENCE_RATE_LIMIT=120
# Environment label written into structured logs / metrics.
ENVIRONMENT=development
# Emit structured JSON logs (LOG_JSON=true) or plain-text logs.
LOG_JSON=true

# ---- SIEM / security & compliance service (Master Spec Batch 1) --------------
# SIEM_JWT_SECRET MUST be at least 32 characters, otherwise the management
# API returns HTTP 503. SIEM_ENCRYPTION_KEY encrypts sensitive event fields
# at rest. Change all three before going live.
SIEM_JWT_SECRET=change-me-siem-jwt-secret-0123456789abcdef
SIEM_INTERNAL_API_KEY=change-me-siem-internal-key
SIEM_ENCRYPTION_KEY=change-me-siem-encryption-key-0123456789abcdef

# ---- Workforce / field operations service (Master Spec Batch 2) --------------
# WORKFORCE_JWT_SECRET MUST be at least 32 characters, otherwise the
# management API returns HTTP 503.
WORKFORCE_JWT_SECRET=change-me-workforce-jwt-secret-0123456789abcdef
WORKFORCE_INTERNAL_API_KEY=change-me-workforce-internal-key

# ---- NMS / network operations service (Master Spec Batch 7c) -----------------
# NMS_JWT_SECRET MUST be at least 32 characters, otherwise the management
# API returns HTTP 503. Change both before going live.
NMS_JWT_SECRET=change-me-nms-jwt-secret-0123456789abcdef
NMS_INTERNAL_API_KEY=change-me-nms-internal-key

# ---- Data warehouse / analytics service (Master Spec Batch 7d) ---------------
# WAREHOUSE_JWT_SECRET MUST be at least 32 characters, otherwise the
# management API returns HTTP 503. Change both before going live.
WAREHOUSE_JWT_SECRET=change-me-warehouse-jwt-secret-0123456789abcdef
WAREHOUSE_INTERNAL_API_KEY=change-me-warehouse-internal-key

# ---- AAA / NAS & RADIUS service (Milestone 0) --------------------------------
# Host port where the AAA API is published (for standalone M0 deployment).
AAA_PORT=8000
# AAA_ENCRYPTION_KEY is a Fernet key used to encrypt NAS credentials at rest.
# Generate one:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# The default below is a VALID but well-known dev key - REPLACE before going live.
AAA_INTERNAL_API_KEY=change-me-aaa-internal-key
AAA_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Management token secret; MUST be >= 32 characters (shared with the admin-token issuer).
AAA_JWT_SECRET=change-me-aaa-jwt-secret-0123456789abcdef
AAA_INTERNAL_RATE_LIMIT=300
AAA_MANAGEMENT_RATE_LIMIT=120
AAA_REQUEST_MAX_BYTES=65536
# false = run `docker compose exec aaa-service alembic upgrade head` before start;
# true  = auto-create tables on boot (dev/quick-start only).
AAA_AUTO_CREATE_SCHEMA=false
# Keep false until NAS command delivery has been explicitly approved and configured.
AAA_ENABLE_RADIUS_COMMANDS=false
# real = talk to actual RouterOS devices; fake = simulation/test only.
AAA_ROUTEROS_ADAPTER=real
# Networks allowed as NAS management sources (comma-separated CIDRs).
NAS_APPROVED_NETWORKS=10.0.0.0/8,192.168.0.0/16
# Allow hostname (not just IP) management endpoints. Keep false in production.
NAS_ALLOW_HOSTNAMES=false
# Keep false in production; permits TLS verification to be disabled per NAS.
AAA_ALLOW_INSECURE_TLS=false
AAA_SESSION_STALE_SECONDS=900
AAA_RADIUS_HEARTBEAT_SECONDS=120
AAA_OUTBOX_BATCH_SIZE=100
AAA_COMMAND_MAX_ATTEMPTS=3
AAA_WORKER_INTERVAL_SECONDS=5

# ---- Identity service (application users + login) ---------------------------
# Platform IAM for the people who USE the system (admins, NOC, sales, KYC...).
# Completely separate from AAA (FreeRADIUS/NAS subscriber auth).
# Login JWTs are signed with PLATFORM_JWT_SECRET if set, else IDENTITY_JWT_SECRET.
# Set the SAME value on every service's <SVC>_JWT_SECRET so one token works
# platform-wide. PLATFORM_JWT_SECRET MUST be >= 32 characters.
PLATFORM_JWT_SECRET=change-me-platform-jwt-secret-0123456789abcdef
IDENTITY_JWT_SECRET=change-me-identity-jwt-secret-0123456789abcdef
IDENTITY_TOKEN_TTL_SECONDS=43200
IDENTITY_INTERNAL_API_KEY=change-me-identity-internal-key
IDENTITY_INTERNAL_API_KEYS=change-me-identity-internal-key
# First admin user created automatically at startup (only when the user table is empty).
IDENTITY_BOOTSTRAP_ADMIN_USERNAME=admin
IDENTITY_BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password

# ---- Optional: observability stack (docker compose --profile observability) --
# No extra vars required; ports above and infra/observability config are used.

# ---- Optional: secrets for the OTHER platform services ----------------------
# Set these when deploying the full platform via Docker so each service's
# management API is secured (each service's JWT secret must be >= 32 chars).
# Leaving them unset lets the service boot with an empty secret, which means
# its management API returns 401/503 until a secret is provided.
# CRM_JWT_SECRET=
# CRM_INTERNAL_API_KEY=
# BSS_JWT_SECRET=
# BSS_INTERNAL_API_KEY=
# OSS_JWT_SECRET=
# OSS_INTERNAL_API_KEY=
# AAA_JWT_SECRET=
# AAA_INTERNAL_API_KEY=
# TENANCY_JWT_SECRET=
# TENANCY_INTERNAL_API_KEY=
# ASSURANCE_JWT_SECRET=
# ASSURANCE_INTERNAL_API_KEY=
# DEVICE_MANAGEMENT_JWT_SECRET=
# DEVICE_MANAGEMENT_INTERNAL_API_KEY=
